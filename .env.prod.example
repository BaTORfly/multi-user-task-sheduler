# Copy this file to .env.prod before running Docker Compose in production-like mode.
# Keep real secrets in local environment variables, CI secrets, or an untracked .env.prod.

PROD_SPRING_PROFILES_ACTIVE=prod

CONFIG_REPOSITORY_URI=https://github.com/BaTORfly/multi-user-task-sheduler.git
PROD_CONFIG_REPOSITORY_LABEL=main

POSTGRES_DB=task_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_ADVERTISED_HOST=localhost

JWT_SECRET=change-me
JWT_ACCESS_LIFETIME=3600
JWT_REFRESH_LIFETIME=86400

SCHEDULER_EMAIL=scheduler@example.com
SCHEDULER_PASSWORD=change-me
SCHEDULER_HASHED_PASSWORD=change-me
SCHEDULER_DAILY_CRON=0 0 0 * * *
SCHEDULER_TIME_ZONE=Europe/Moscow

SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=change-me
SPRING_MAIL_PASSWORD=change-me
